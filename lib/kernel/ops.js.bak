/**
 * dsh-c4d 建模操作 —— 挤出/旋转/扫描/放样、镜像与 MoGraph 克隆。
 *
 * 与 C4D 的对应：Extrude（挤出）、Lathe（旋转）、Sweep（扫描）、Loft（放样）、
 * Mirror（镜像）、Cloner（克隆：线性/径向/网格）。
 */

import { emptyMesh, mergeMeshes, transformMesh, matCompose, flipMesh } from './mesh.js';

/** 法线平均 → 顶点法线（供放样/扫描焊接）。 */
function avgNormals(mesh) {
  const acc = mesh.verts.map(() => [0, 0, 0]);
  for (const f of mesh.faces) {
    const [a, b, c] = f.map((i) => mesh.verts[i]);
    const ux = b[0] - a[0], uy = b[1] - a[1], uz = b[2] - a[2];
    const vx = c[0] - a[0], vy = c[1] - a[1], vz = c[2] - a[2];
    let nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;
    acc[a[0]][0] += nx; acc[a[0]][1] += ny; acc[a[0]][2] += nz;
    acc[b[0]][0] += nx; acc[b[0]][1] += ny; acc[b[0]][2] += nz;
    acc[c[0]][0] += nx; acc[c[0]][1] += ny; acc[c[0]][2] += nz;
  }
  return acc.map((n) => {
    const len = Math.hypot(n[0], n[1], n[2]);
    return len === 0 ? [0, 0, 0] : [n[0] / len, n[1] / len, n[2] / len];
  });
}

/** 多边形耳切三角化（2D 点，支持凹多边形，如星形）。返回三角形索引。 */
export function earClip(points) {
  const n = points.length;
  if (n < 3) return [];
  // 面积判断绕向（保证逆时针）
  let area = 0;
  for (let i = 0; i < n; i++) {
    const j = (i + 1) % n, k = (i + 2) % n;
    area += points[i][0] * points[j][1] - points[j][0] * points[i][1];
  }
  const idx = area < 0 ? Array.from({ length: n }, (_, i) => n - 1 - i) : Array.from({ length: n }, (_, i) => i);
  const cross = (o, a, b) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
  const triangles = [];
  const remaining = [...idx];
  let guard = 0;
  while (remaining.length > 3 && guard++ < 10000) {
    let clipped = false;
    for (let i = 0; i < remaining.length; i++) {
      const a = remaining[(i - 1 + remaining.length) % remaining.length];
      const b = remaining[i];
      const c = remaining[(i + 1) % remaining.length];
      const pa = points[a], pb = points[b], pc = points[c];
      if (cross(pa, pb, pc) <= 0) continue;
      // 凸角 + 无其它点落入三角形内
      let inside = false;
      for (const vi of remaining) {
        if (vi === a || vi === b || vi === c) continue;
        const p = points[vi];
        const d1 = cross(pa, pb, p), d2 = cross(pb, pc, p), d3 = cross(pc, pa, p);
        if (d1 >= 0 && d2 >= 0 && d3 >= 0) { inside = true; break; }
      }
      if (inside) continue;
      triangles.push([a, b, c]);
      remaining.splice(i, 1);
      clipped = true;
      break;
    }
    if (!clipped) break;
  }
  if (remaining.length === 3) triangles.push([remaining[0], remaining[1], remaining[2]]);
  return triangles;
}

/** 简单几何半径下的圆截面 2D 点（供 profile 默认值）。 */
export function circleProfile({ r = 100, seg = 32 } = {}) {
  const pts = [];
  for (let i = 0; i < seg; i++) {
    const t = 2 * Math.PI * i / seg;
    pts.push([r * Math.cos(t), r * Math.sin(t)]);
  }
  return pts;
}

/** 星形 2D 截面。 */
export function starProfile({ r1 = 40, r2 = 100, points = 5 } = {}) {
  const pts = [];
  for (let i = 0; i < points * 2; i++) {
    const t = Math.PI * i / points;
    const rr = i % 2 === 0 ? r2 : r1;
    pts.push([rr * Math.cos(t), rr * Math.sin(t)]);
  }
  return pts;
}

/**
 * 挤出 Extrude（C4D 挤出）：2D 截面沿 +Y 挤出 depth；绕向自动修正。
 */
export function extrude({ profile, depth = 200, cap = true } = {}) {
  const out = emptyMesh();
  const n = profile.length;
  if (n < 3) return out;
  const y0 = -depth / 2, y1 = depth / 2;
  const bottom = [], top = [];
  for (const [px, py] of profile) {
    out.verts.push([px, y0, py]);
    bottom.push(out.verts.length - 1);
  }
  for (const [px, py] of profile) {
    out.verts.push([px, y1, py]);
    top.push(out.verts.length - 1);
  }
  for (let i = 0; i < n; i++) {
    const j = (i + 1) % n;
    out.faces.push([bottom[i], bottom[j], top[j]], [bottom[i], top[j], top[i]]);
  }
  if (cap) {
    const tris = earClip(profile);
    for (const [a, b, c] of tris) {
      out.faces.push([bottom[a], bottom[b], bottom[c]]); // 底面（-Y 法线）
      out.faces.push([top[a], top[c], top[b]]);           // 顶面（+Y 法线）
    }
  }
  return out;
}

/**
 * 旋转 Lathe（C4D 旋转）：2D 截面绕 Y 轴旋转 angle 度（默认 360 = 闭合）。
 * profile 的 X 必须 ≥ 0（旋转半径），Y 为高度。
 */
export function lathe({ profile, angle = 360, seg = 32 } = {}) {
  const out = emptyMesh();
  const closed = angle >= 359.999;
  const steps = Math.max(2, seg);
  const cols = closed ? steps : steps + 1;
  const n = profile.length;
  const rad = Math.PI / 180;
  const ringAt = (k) => {
    const theta = angle * rad * k / steps;
    const cos = Math.cos(theta), sin = Math.sin(theta);
    return profile.map(([px, py]) => [px * cos, py, px * sin]);
  };
  const rings = [];
  for (let k = 0; k < cols; k++) {
    const ring = ringAt(k);
    const idx = [];
    for (const p of ring) { out.verts.push(p); idx.push(out.verts.length - 1); }
    rings.push(idx);
  }
  for (let k = 0; k + 1 < rings.length; k++) {
    for (let i = 0; i + 1 < n; i++) {
      const a = rings[k][i], b = rings[k][i + 1];
      const c = rings[k + 1][i + 1], d = rings[k + 1][i];
      out.faces.push([a, b, c], [a, c, d]);
    }
  }
  if (closed) {
    // 闭合接缝焊接（相同坐标顶点合一）
    const seamStart = rings[0], seamEnd = rings[rings.length - 1];
    for (let i = 0; i < n; i++) {
      const a = seamStart[i], b = seamEnd[i];
      // 把指向 b 的引用改为 a
      for (const f of out.faces) {
        for (let k = 0; k < 3; k++) if (f[k] === b) f[k] = a;
      }
    }
  }
  // 端盖（未闭合时）
  if (!closed) {
    const capTris = earClip(profile);
    for (const [a, b, c] of capTris) {
      out.faces.push([rings[0][a], rings[0][b], rings[0][c]]);
      out.faces.push([rings[rings.length - 1][a], rings[rings.length - 1][c], rings[rings.length - 1][b]]);
    }
  }
  return out;
}

/**
 * 扫描 Sweep（C4D 扫描）：2D 截面沿 3D 路径点扫掠（平行传输标架）。
 */
export function sweep({ profile, path, closed = false } = {}) {
  const out = emptyMesh();
  const n = profile.length;
  if (path.length < 2 || n < 3) return out;
  const frames = [];
  let prevN = null;
  for (let i = 0; i < path.length; i++) {
    const pos = path[i];
    const a = path[Math.max(0, i - 1)], b = path[Math.min(path.length - 1, i + 1)];
    const tangent = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];
    const tl = Math.hypot(...tangent) || 1;
    const T = tangent.map((c) => c / tl);
    let N = prevN === null ? (Math.abs(T[1]) < 0.9 ? [0, 1, 0] : [1, 0, 0]) : prevN;
    const dot = N[0] * T[0] + N[1] * T[1] + N[2] * T[2];
    N = [N[0] - dot * T[0], N[1] - dot * T[1], N[2] - dot * T[2]];
    const nl = Math.hypot(...N) || 1;
    N = N.map((c) => c / nl);
    frames.push({ pos, N });
    prevN = N;
  }
  const built = [];
  for (const { pos, N } of frames) {
    const idx = [];
    for (const [px, py] of profile) {
      // profile 平面：X → N，Y → B（B = N 的切向垂直向量）
      const B = [-N[2], 0, N[0]];
      const bl = Math.hypot(...B) || 1;
      const Bu = [B[0] / bl, B[1] / bl, B[2] / bl];
      out.verts.push([
        pos[0] + px * N[0] + py * Bu[0],
        pos[1] + px * N[1] + py * Bu[1],
        pos[2] + px * N[2] + py * Bu[2],
      ]);
      idx.push(out.verts.length - 1);
    }
    built.push(idx);
  }
  const last = built.length - 1;
  for (let k = 0; k < last; k++) {
    for (let i = 0; i < n; i++) {
      const j = (i + 1) % n;
      out.faces.push([built[k][i], built[k][j], built[k + 1][j]], [built[k][i], built[k + 1][j], built[k + 1][i]]);
    }
  }
  if (closed) {
    for (let i = 0; i < n; i++) {
      const j = (i + 1) % n;
      out.faces.push([built[last][i], built[last][j], built[0][j]], [built[last][i], built[0][j], built[0][i]]);
    }
  }
  return out;
}

/**
 * 放样 Loft（C4D 放样）：沿高度列表放样多个 2D 截面（同点数）。profile 为 [[ [x,y],... ],...]，每个子截面点数一致。
 */
export function loft({ profiles, height = 200 } = {}) {
  const out = emptyMesh();
  if (profiles.length < 2) return out;
  const rings = [];
  for (let k = 0; k < profiles.length; k++) {
    const y = -height / 2 + height * k / (profiles.length - 1);
    const idx = [];
    for (const [px, py] of profiles[k]) {
      out.verts.push([px, y, py]);
      idx.push(out.verts.length - 1);
    }
    rings.push(idx);
  }
  const n = profiles[0].length;
  for (let k = 0; k + 1 < rings.length; k++) {
    for (let i = 0; i < n; i++) {
      const j = (i + 1) % n;
      out.faces.push([rings[k][i], rings[k][j], rings[k + 1][j]], [rings[k][i], rings[k + 1][j], rings[k + 1][i]]);
    }
  }
  const capTris0 = earClip(profiles[0]);
  const capTris1 = earClip(profiles[profiles.length - 1]);
  for (const [a, b, c] of capTris0) out.faces.push([rings[0][a], rings[0][b], rings[0][c]]);
  for (const [a, b, c] of capTris1) out.faces.push([rings[rings.length - 1][a], rings[rings.length - 1][c], rings[rings.length - 1][b]]);
  return out;
}

/** 镜像 Mirror（C4D 镜像）：axis = x/y/z，绕世界平面镜像并合并。 */
export function mirror(mesh, { axis = 'x', weld = true } = {}) {
  const idx = axis === 'x' ? 0 : axis === 'y' ? 1 : 2;
  const flipped = flipMesh(mesh);
  const other = {
    verts: flipped.verts.map((v) => {
      const c = [...v];
      c[idx] = -c[idx];
      return c;
    }),
    faces: flipped.faces,
  };
  return weld ? mergeMeshes(mesh, other) : mergeMeshes(mesh, other);
}

/** 世界矩阵（position/rotation/scale）。 */
function worldMatrix(obj) {
  return matCompose(obj);
}

/**
 * MoGraph 克隆 Cloner（C4D 克隆）：
 *   linear：count + step [x,y,z]
 *   radial：count + radius + axis(x/y/z) + startAngle（度）
 *   grid：count [nx,ny,nz] + step [x,y,z]
 */
export function clone(childMesh, { mode = 'linear', count = 5, step = [0, 0, 0], radius = 200, axis = 'y', startAngle = 0, grid = [2, 2, 2] } = {}) {
  const out = emptyMesh();
  const place = (i, j, k) => {
    let mesh = childMesh;
    if (mode === 'linear') {
      const [sx, sy, sz] = step;
      mesh = transformMesh(mesh, [1, 0, 0, sx * i, 0, 1, 0, sy * (j ?? 0), 0, 0, 1, sz * (k ?? 0), 0, 0, 0, 1]);
    } else if (mode === 'radial') {
      const theta = (startAngle + 360 * i / Math.max(1, count)) * Math.PI / 180;
      const cx = Math.cos(theta), sx = Math.sin(theta);
      const ax = axis === 'x' ? 0 : axis === 'z' ? 2 : 1;
      const p = [radius * cx, 0, radius * sx];
      if (ax === 1) p.splice(1, 0, p.pop()); // axis Y：[0, r, 0]
      else if (ax === 0) { const t = p[0]; p[0] = -p[2]; p[2] = t; } // axis X
      mesh = transformMesh(mesh, [1, 0, 0, p[0], 0, 1, 0, p[1], 0, 0, 1, p[2], 0, 0, 0, 1]);
    } else {
      const [nx, ny, nz] = grid;
      const [sx, sy, sz] = step;
      mesh = transformMesh(mesh, [1, 0, 0, (i - (nx - 1) / 2) * sx, 0, 1, 0, (j - (ny - 1) / 2) * sy, 0, 0, 1, (k - (nz - 1) / 2) * sz, 0, 0, 0, 1]);
    }
    return mesh;
  };
  if (mode === 'linear') {
    for (let i = 0; i < count; i++) { const m = place(i); out.verts.push(...m.verts); out.faces.push(...m.faces); }
  } else if (mode === 'radial') {
    for (let i = 0; i < count; i++) { const m = place(i); out.verts.push(...m.verts); out.faces.push(...m.faces); }
  } else {
    const [nx, ny, nz] = grid;
    for (let i = 0; i < nx; i++) for (let j = 0; j < ny; j++) for (let k = 0; k < nz; k++) {
      const m = place(i, j, k);
      out.verts.push(...m.verts); out.faces.push(...m.faces);
    }
  }
  return out;
}

export { worldMatrix };
